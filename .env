APP_NAME="East Africa Store"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com

APP_KEY=GENERATE_THIS_LOCALLY

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DATABASE_URL=YOUR_RENDER_POSTGRES_INTERNAL_DATABASE_URL

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

QUEUE_CONNECTION=database

FILESYSTEM_DISK=s3

STORE_CURRENCY=USD

PAYMENT_TIMEOUT_MINUTES=30
REFERRAL_REWARD_PERCENTAGE=5

# ============================================================
# PAYSTACK
# ============================================================

PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx

# ============================================================
# BINANCE PAY
# ============================================================

BINANCE_API_KEY=xxxxxxxxxxxxxxxx
BINANCE_SECRET_KEY=xxxxxxxxxxxxxxxx
BINANCE_MERCHANT_ID=xxxxxxxxxxxxxxxx
BINANCE_API_URL=https://bpay.binanceapi.com

# ============================================================
# MAIL
# ============================================================

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=xxxxxxxx
MAIL_PASSWORD=xxxxxxxx
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=orders@example.com
MAIL_FROM_NAME="East Africa Store"

# ============================================================
# WHATSAPP
# ============================================================

WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxxxxx

# ============================================================
# OBJECT STORAGE
# ============================================================

AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxx
AWS_DEFAULT_REGION=auto
AWS_BUCKET=east-africa-store
AWS_ENDPOINT=https://YOUR-OBJECT-STORAGE-ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false
